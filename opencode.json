{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "MMO.WorldServer/**":         "deny",
      "MMO.Auth/**":                "deny",
      "MMO.AppHost/**":             "deny",
      "MMO.Shared/**":              "deny",
      "MMO.Database.Shared/**":     "deny",
      "MMO.Database.Migrations/**": "deny",
      "MMO.Dev.DevAPI/**":          "deny"
    },
    "bash": {
      "*": "ask",
      "dotnet build MMO.slnx*":    "ask",
      "dotnet restore *":          "ask"
    }
  }
}
